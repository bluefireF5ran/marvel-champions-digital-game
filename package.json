{
  "name": "marvel-champions-game",
  "version": "0.29.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "pnpm --filter @mc/client dev",
    "preview": "pnpm --filter @mc/client build && pnpm --filter @mc/client preview",
    "desktop:dev": "pnpm --filter @mc/client desktop:dev",
    "desktop:build": "node scripts/build-desktop.mjs",
    "ship-it": "node scripts/ship-it.mjs",
    "ios": "pnpm --filter @mc/client ios",
    "android": "pnpm --filter @mc/client android",
    "cap": "pnpm --filter @mc/client cap",
    "android:build": "node scripts/build-android.mjs",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:affected": "node scripts/test-affected.mjs",
    "typecheck": "pnpm -r typecheck",
    "e2e": "pnpm --filter @mc/client e2e",
    "e2e:verify": "sh .githooks/e2e-gate.sh HEAD",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "changelog:check": "node scripts/check-changelog.mjs",
    "yaml:lint": "uvx yamllint@1.38.0 --strict .",
    "check": "pnpm lint && pnpm fmt:check && pnpm yaml:lint && pnpm changelog:check && pnpm typecheck && pnpm test && pnpm build",
    "capture:screens": "node scripts/capture-design-screenshots.mjs",
    "screenshots": "node scripts/shoot-screens.mjs",
    "campaign:scrape": "uv run scripts/scrape_campaign_markdown.py",
    "card-art": "uv run scripts/fetch_card_art.py",
    "card-art:compress": "uv run scripts/fetch_card_art.py compress",
    "ingest": "pnpm --filter @mc/content ingest --",
    "clean": "node scripts/clean.mjs",
    "refs": "pnpm --filter @mc/cards exec vitest run --config vitest.tools.config.ts --reporter=verbose --silent=false refs-report",
    "card": "pnpm --filter @mc/cards exec vitest run --config vitest.tools.config.ts --reporter=verbose --silent=false card-brief",
    "dsl": "pnpm --filter @mc/cards exec vitest run --config vitest.tools.config.ts --reporter=verbose --silent=false dsl-index",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs}": [
      "oxlint",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,yml,yaml,toml,css,html}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{yml,yaml}": "uvx yamllint@1.38.0 --strict",
    ".changes/unreleased/*.yaml": "node scripts/check-changelog.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0"
}
