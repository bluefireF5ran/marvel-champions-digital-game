{
  "name": "@mc/client",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-platform tabletop-style game client (Sentinels of the Multiverse-style 2D board), drawn entirely in Phaser 4. Presents engine state and captures input; owns no rules.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "node ../../scripts/build-desktop.mjs",
    "cap": "cap",
    "mobile:sync": "pnpm build && cap sync",
    "ios": "pnpm mobile:sync && cap run ios",
    "android": "pnpm mobile:sync && cap run android",
    "ios:open": "pnpm mobile:sync && cap open ios",
    "android:open": "pnpm mobile:sync && cap open android",
    "android:build": "node ../../scripts/build-android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@mc/cards": "workspace:*",
    "@mc/content": "workspace:*",
    "@mc/engine": "workspace:*",
    "@mc/sync-worker": "workspace:*",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-http": "^2.8.2",
    "@tauri-apps/plugin-opener": "^2.7.1",
    "phaser": "^4.2.1",
    "phaser4-rex-plugins": "^4.2.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^24.19.2",
    "fake-indexeddb": "^6.2.5",
    "vite": "^8.3.4"
  }
}
