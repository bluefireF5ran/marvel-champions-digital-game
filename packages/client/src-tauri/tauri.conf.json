{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Marvel Champions",
  "version": "0.29.0",
  "identifier": "com.quincarter.marvelchampions",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev --port 5173 --strictPort",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Marvel Champions",
        "width": 1440,
        "height": 900,
        "minWidth": 640,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0e0c0a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "CardGame",
    "shortDescription": "A fan-made digital edition of Marvel Champions: The Card Game",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "rpm": { "compression": { "type": "none" } }
    },
    "windows": {
      "nsis": { "compression": "none" }
    }
  }
}
