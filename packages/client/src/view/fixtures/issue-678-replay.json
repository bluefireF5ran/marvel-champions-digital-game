      "instructions": [
        {
          "instructionId": "mc16.s4.setup.reveal-standard",
          "text": "Reveal the Guerrilla Tactics side scheme.",
          "citation": "MC16 p. 14",
          "window": "afterScenarioSetup",
          "effects": [
            {
              "kind": "selectCards",
              "slot": "challenge",
              "cards": { "kind": "encounterSetAside", "filter": { "printedId": "16181a" } }
            },
            {
              "kind": "revealCard",
              "cards": { "kind": "slot", "slot": "challenge" },
              "player": { "kind": "firstPlayer" }
            }
          ]
        },
        {
          "instructionId": "mc16.s4.setup.artifacts",
          "text": "Shuffle each Galactic Artifacts side scheme recorded in the \u201cGalactic Artifacts Side Schemes in the Victory Display\u201d section of the campaign log into the encounter deck. Perform the following for each specified side scheme shuffled in this way: Hujadarian Monarch Egg: place 1 evasion counter on Nebula's Ship. Magical Teapot: deal the first player 1 facedown encounter card. Philosopher's Stone: give Nebula 1 facedown boost card. Crystal Ball: give Nebula a tough status card.",
          "citation": "MC16 p. 14",
          "window": "afterScenarioSetup",
          "effects": [
            {
              "kind": "moveCards",
              "cards": { "kind": "campaignLog", "field": "galacticArtifacts" },
              "to": "encounterDeckShuffle"
            },
            {
              "kind": "if",
              "condition": { "kind": "campaignLog", "field": "galacticArtifacts", "has": "16127" },
              "then": [
                {
                  "kind": "addCounters",
                  "target": { "kind": "each", "query": { "categories": ["environment"], "name": "Nebula's Ship" } },
                  "counterType": "evasion",
                  "amount": { "kind": "const", "value": 1 }
                }
              ]
            },
            {
              "kind": "if",
              "condition": { "kind": "campaignLog", "field": "galacticArtifacts", "has": "16128" },
              "then": [{ "kind": "dealEncounterCard", "player": { "kind": "firstPlayer" } }]
            },
            {
              "kind": "if",
              "condition": { "kind": "campaignLog", "field": "galacticArtifacts", "has": "16129" },
              "then": [{ "kind": "giveBoostCard", "enemy": { "kind": "villain" } }]
            },
            {
              "kind": "if",
              "condition": { "kind": "campaignLog", "field": "galacticArtifacts", "has": "16130" },
              "then": [{ "kind": "giveStatus", "target": { "kind": "villain" }, "status": "tough" }]
            }
          ]
        },
        {
          "instructionId": "mc16.s4.setup.headhunter",
          "text": "Shuffle the Badoon Headhunter (183) minion into the encounter deck. Then, if the number of marks in the \u201cHeadhunter Defeated?\u201d section of the campaign log is equal to or greater than the listed number, shuffle that card into the encounter deck as well.",
          "citation": "MC16 p. 14",
          "window": "afterScenarioSetup",
          "effects": [
            {
              "kind": "moveCards",
              "cards": { "kind": "encounterSetAside", "filter": { "printedId": "16183" } },
              "to": "encounterDeckShuffle"
            },
            {
              "kind": "if",
              "condition": { "kind": "campaignLog", "field": "headhunterDefeated", "atLeast": 1 },
              "then": [
                {
                  "kind": "moveCards",
                  "cards": { "kind": "encounterSetAside", "filter": { "printedId": "16184" } },
                  "to": "encounterDeckShuffle"
                }
              ]
            },
            {
              "kind": "if",
              "condition": { "kind": "campaignLog", "field": "headhunterDefeated", "atLeast": 2 },
              "then": [
                {
                  "kind": "moveCards",
                  "cards": { "kind": "encounterSetAside", "filter": { "printedId": "16185" } },
                  "to": "encounterDeckShuffle"
                }
              ]
            },
            {
              "kind": "if",
              "condition": { "kind": "campaignLog", "field": "headhunterDefeated", "atLeast": 3 },
              "then": [
                {
                  "kind": "moveCards",
                  "cards": { "kind": "encounterSetAside", "filter": { "printedId": "16186" } },
                  "to": "encounterDeckShuffle"
                }
              ]
            }
          ]
        }
