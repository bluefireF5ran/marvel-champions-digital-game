{
  "name": "@mc/content",
  "version": "0.0.0",
  "private": true,
  "description": "Card data schema and structured card content (text, stats, metadata) versioned by cycle/set. No art assets.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json",
    "ingest": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/ingest-marvelcdb.ts",
    "catalog": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/generate-catalog.ts",
    "export-added-records": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/export-added-records.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2"
  }
}
